{
  "elements": [
    {
      "id": "1.C.1.a",
      "name_en": "Achievement/Effort",
      "name_th": null,
      "description_en": "Job requires establishing and maintaining personally challenging achievement goals and exerting effort toward mastering tasks."
    },
    {
      "id": "1.C.1.b",
      "name_en": "Persistence",
      "name_th": null,
      "description_en": "Job requires persistence in the face of obstacles."
    },
    {
      "id": "1.C.1.c",
      "name_en": "Initiative",
      "name_th": null,
      "description_en": "Job requires a willingness to take on responsibilities and challenges."
    },
    {
      "id": "1.C.2.b",
      "name_en": "Leadership",
      "name_th": null,
      "description_en": "Job requires a willingness to lead, take charge, and offer opinions and direction."
    },
    {
      "id": "1.C.3.a",
      "name_en": "Cooperation",
      "name_th": null,
      "description_en": "Job requires being pleasant with others on the job and displaying a good-natured, cooperative attitude."
    },
    {
      "id": "1.C.3.b",
      "name_en": "Concern for Others",
      "name_th": null,
      "description_en": "Job requires being sensitive to others' needs and feelings and being understanding and helpful on the job."
    },
    {
      "id": "1.C.3.c",
      "name_en": "Social Orientation",
      "name_th": null,
      "description_en": "Job requires preferring to work with others rather than alone, and being personally connected with others on the job."
    },
    {
      "id": "1.C.4.a",
      "name_en": "Self-Control",
      "name_th": null,
      "description_en": "Job requires maintaining composure, keeping emotions in check, controlling anger, and avoiding aggressive behavior, even in very difficult situations."
    },
    {
      "id": "1.C.4.b",
      "name_en": "Stress Tolerance",
      "name_th": null,
      "description_en": "Job requires accepting criticism and dealing calmly and effectively with high-stress situations."
    },
    {
      "id": "1.C.4.c",
      "name_en": "Adaptability/Flexibility",
      "name_th": null,
      "description_en": "Job requires being open to change (positive or negative) and to considerable variety in the workplace."
    },
    {
      "id": "1.C.5.a",
      "name_en": "Dependability",
      "name_th": null,
      "description_en": "Job requires being reliable, responsible, and dependable, and fulfilling obligations."
    },
    {
      "id": "1.C.5.b",
      "name_en": "Attention to Detail",
      "name_th": null,
      "description_en": "Job requires being careful about detail and thorough in completing work tasks."
    },
    {
      "id": "1.C.5.c",
      "name_en": "Integrity",
      "name_th": null,
      "description_en": "Job requires being honest and ethical."
    },
    {
      "id": "1.C.6",
      "name_en": "Independence",
      "name_th": null,
      "description_en": "Job requires developing one's own ways of doing things, guiding oneself with little or no supervision, and depending on oneself to get things done."
    },
    {
      "id": "1.C.7.a",
      "name_en": "Innovation",
      "name_th": null,
      "description_en": "Job requires creativity and alternative thinking to develop new ideas for and answers to work-related problems."
    },
    {
      "id": "1.C.7.b",
      "name_en": "Analytical Thinking",
      "name_th": null,
      "description_en": "Job requires analyzing information and using logic to address work-related issues and problems."
    }
  ],
